# ==============================================================================
# AI Incident Monitor — Modern Environment Variables Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR ACTUAL SECRETS.
# NEVER COMMIT THE ACTUAL .env FILE TO GIT!
# ==============================================================================

# Supabase Project Connection URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Modern Supabase Publishable Key (sb_publishable_...) - Safe for Frontend / Public Read
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Modern Supabase Secret Key (sb_secret_...) - Strictly for Backend Ingestion & Admin Writes
# Keep this secret! Never expose this in client-side code or public repositories.
SUPABASE_SECRET_KEY=sb_secret_...

# Google Gemini / Gemma API Key (Used for LLM Gatekeeper, Taxonomy Extraction & Dedup)
GEMINI_API_KEY=AQ.Ab8RN...

# Optional: Google Cloud Project ID for GDELT BigQuery queries
GCP_PROJECT_ID=your-gcp-project-id
